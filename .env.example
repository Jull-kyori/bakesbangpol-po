# Salin file ini menjadi .env lalu ganti nilainya
ADMIN_PASSWORD=ganti_dengan_password_acak_minimal_16_karakter
PORT=3000
# Isi true jika website dibuka lewat HTTPS
COOKIE_SECURE=false
# Isi jumlah hop proxy tepercaya hanya jika server berada di belakang reverse proxy.
# Contoh: 1 untuk satu proxy yang dikendalikan sendiri.
# TRUST_PROXY_HOPS=
# Asisten AI Groq (simpan API key hanya di .env server; jangan pernah commit)
GROQ_API_KEY=isi_api_key_di_server
GROQ_MODEL=openai/gpt-oss-20b
